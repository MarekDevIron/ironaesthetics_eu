RewriteEngine On

# Let's Encrypt (ISPConfig) overuje doménu cez /.well-known/acme-challenge/ — musí
# prejsť skôr, než nižšie zakážeme všetko bodkové, inak zlyhá vydanie aj obnova certifikátu.
RewriteRule ^\.well-known/ - [L]

# .git (ak deploy nahráva celý pracovný strom), bodkové súbory, config a dev/diag
# súbory nikdy neservírovať — tieto by inak boli priamo sťahovateľné, lebo sú to
# reálne súbory a RewriteCond nižšie ich preto nepošle cez index.php.
RewriteRule (^|/)\. - [F,L]

# cache/ (ak keš neleží v ../private, viď cache_dir() v lib.php) a views/ nie sú na
# priame volanie — views bez premenných z index.php len vypíšu prázdnu šablónu.
RewriteRule ^(cache|views)(/|$) - [F,L]

# config.* chytá aj zálohy (config.php.bak by Apache poslal ako text aj s heslom DB),
# bežné záložné prípony pre istotu tiež. lib.php sa nemá volať napriamo.
<FilesMatch "^(config\..*|lib\.php|test\.php|dev\.sh|dev-serve\.command|README\.md|.*\.(bak|old|orig|novy|povodny|sql|log|swp))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # inline <style>/<script> vo views, geolokácia z prehliadača cez get.geojs.io
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://get.geojs.io; frame-ancestors 'none'"
</IfModule>

# všetko, čo nie je reálny súbor (vlajky, fonty), ide do index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
